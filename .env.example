# Telegram bot token from @BotFather (required)
TG_BOT_TOKEN=

# Webhook configuration. If empty, the bot starts in long-poll mode (good for dev).
WEBHOOK_URL=https://id.libermall.com
WEBHOOK_SECRET=

# Mini App URL — opened from inline buttons and the bot menu button.
MINI_APP_URL=https://id.libermall.com/app/

# Marketing landing URL — used for the "Website" button.
LOGIN_URL=https://id.libermall.com/

# Casdoor admin credentials — used to sync chat_id / language_code / premium
# / last_seen into user.properties. Leave empty to disable sync.
CASDOOR_URL=https://id.libermall.com
CASDOOR_ADMIN_USER=admin
CASDOOR_ADMIN_PASS=

# HTTP port for the webhook server.
PORT=3000
